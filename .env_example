# Claude API key and default model
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# For local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-nemo:latest 

# NVIDIA NIM (build.nvidia.com — OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Portkey
PORTKEY_MODEL=Qwen2.5:7b
PORTKEY_BASE_URL=
PORTKEY_API_KEY=

# OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=

# Toggle to select LLM provider: "ANTHROPIC", "NVIDIA",,"PORTKEY" or "OLLAMA"
LLM_PROVIDER_SELECTOR=NVIDIA

# Toggle to set logging level (e.g., DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG

# LangFuse tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://jp.cloud.langfuse.com

# USING LANGFUSE (see above)
# Optional: LangSmith tracing
#LANGCHAIN_TRACING_V2=false
#LANGCHAIN_API_KEY=your_langsmith_api_key_here
#LANGCHAIN_PROJECT=deep-agents
