{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "ReAct Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/run_react_agent.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Multi-Agent Supervisor",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/examples/run_multi_agent.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "A2A Weather Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agents/a2a/weather_agent/a2a_weather_agent.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "A2A Orchestrator Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/agents/a2a/orchestrator_agent/a2a_orchestrator_agent.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env"
    },
  ],
  "compounds": [
    {
      "name": "A2A Agents (Weather + Orchestrator)",
      "configurations": ["A2A Weather Agent", "A2A Orchestrator Agent"],
      "presentation": {
        "order": ["A2A Weather Agent", "A2A Orchestrator Agent"]
      }
    }
  ]
}
